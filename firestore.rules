rules_version = '2';

// กฎ Firestore ของระบบสั่งอาหาร (หลายร้าน)
// - พนักงานร้าน: เปิดลิงก์แล้วเข้าได้เลย (ไม่มีอีเมล/รหัสผ่าน) แบบเดียวกับ MUKRATA
//   ถ้าอยากกันคนอื่น ตั้ง "รหัสร้าน" ในแอป (ตั้งค่า → ความปลอดภัย) → เครื่องที่ใส่รหัสถูก 1 ครั้งถึงเป็นพนักงาน
//   (รหัสเก็บที่ config/access  เครื่องที่ใส่แล้วเก็บเป็น staff/{uid})
//   ยังไม่ตั้งรหัส = ใครก็ตามที่เปิดลิงก์ (รวมนักเรียนที่รู้วิธี) อ่าน/เขียนข้อมูลร้านได้
// - นักเรียน = ผู้ใช้ไม่ระบุตัวตน (Anonymous): อ่านชื่อร้าน/เมนูได้, สร้างออเดอร์ QR ได้, อ่านได้เฉพาะออเดอร์ของตัวเอง,
//   แก้ออเดอร์ตัวเองได้อย่างเดียวคือกด "ฉันโอนแล้ว"
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }
    function staff() {
      return request.auth != null
        && (!exists(accessPath())
            || (exists(/databases/$(database)/documents/staff/$(request.auth.uid))
                && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.code == get(accessPath()).data.code));
    }

    // เครื่องที่ใส่รหัสร้านถูกแล้ว: สร้างเอกสาร staff/{uid ของเครื่องเอง} ได้เมื่อรหัสตรงกับ config/access
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string
        && request.resource.data.code == getAfter(accessPath()).data.code;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // รหัสร้าน (config/access) — อ่านได้เฉพาะพนักงาน · config/probe ใช้เช็กว่าเครื่องนี้เป็นพนักงานไหม
    match /config/{doc} {
      allow read: if staff();
      allow create, update: if staff() && doc == 'access'
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4 && request.resource.data.code.size() <= 40;
      allow delete: if staff() && doc == 'access';
    }

    // ตรวจรูปแบบออเดอร์คร่าวๆ กันข้อมูลพัง
    function validOrder(d) {
      return d.number is int && d.number > 0
        && d.dateKey is string && d.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt is timestamp
        && d.items is list && d.items.size() > 0 && d.items.size() <= 100
        && d.total is number && d.total >= 0
        && d.paid is bool
        && d.cancelled is bool;
    }

    // ออเดอร์ที่นักเรียนสร้างจาก QR: ต้องสร้างพร้อมกับเพิ่มตัวนับคิวของวัน และร้านต้องเปิดรับอยู่
    function validQrCreate(shop, d) {
      return signedIn()
        && validOrder(d)
        && d.keys().hasOnly(['number', 'qnum', 'uid', 'dateKey', 'createdAt', 'items', 'total', 'paid', 'payMethod',
                             'payClaimed', 'cancelled', 'source', 'type', 'name', 'table'])
        && d.source == 'qr'
        && d.uid == request.auth.uid
        && d.paid == false && d.cancelled == false && d.payClaimed == false
        && d.qnum == d.number
        && d.createdAt == request.time
        && d.items.size() <= 30
        && d.total > 0 && d.total <= 5000
        && (!('name' in d) || (d.name is string && d.name.size() <= 20))
        && get(/databases/$(database)/documents/shops/$(shop)).data.qrOpen == true
        && get(/databases/$(database)/documents/shops/$(shop)).data.get('qrOrdering', true) == true
        && getAfter(/databases/$(database)/documents/shops/$(shop)/counters/$(d.dateKey)).data.n == d.number;
    }

    match /shops/{shop} {
      // ชื่อร้าน สถานะเปิดรับ QR และเลขพร้อมเพย์ — นักเรียนต้องเห็น
      allow read: if true;
      allow write: if staff();

      match /menu/{id} {
        allow read: if true;
        allow delete: if staff();
        allow create, update: if staff()
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.price is number && request.resource.data.price >= 0;
      }

      match /orders/{id} {
        allow get: if staff() || (signedIn() && resource.data.uid == request.auth.uid);
        allow list: if staff();
        allow create: if (staff() && validOrder(request.resource.data))
          || validQrCreate(shop, request.resource.data);
        allow update: if (staff() && validOrder(request.resource.data)
            // แก้ได้ แต่ห้ามเปลี่ยนเลขออเดอร์และวันที่
            && request.resource.data.number == resource.data.number
            && request.resource.data.dateKey == resource.data.dateKey)
          || (signedIn() && resource.data.uid == request.auth.uid
            // นักเรียนกด "ฉันโอนแล้ว" ได้อย่างเดียว
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payClaimed', 'payClaimedAt'])
            && request.resource.data.payClaimed == true
            && request.resource.data.payClaimedAt == request.time);
        // ไม่ลบจริง ใช้ cancelled: true แทน เพื่อเก็บประวัติ
        allow delete: if false;
      }

      // ยอดรายวัน (สำหรับสรุปรายเดือน/รายปี): เฉพาะพนักงาน
      match /days/{day} {
        allow read, write: if staff();
      }

      // ตัวนับเลขคิว Q ของแต่ละวัน: เพิ่มได้ทีละ 1 เท่านั้น
      match /counters/{day} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
        allow update: if signedIn() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
        allow delete: if false;
      }
    }

    // เอกสารอื่นนอกจากนี้ ห้ามทั้งหมด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
